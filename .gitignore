node_modules/
.env
*.log
*.tsbuildinfo
codex-prompt-*.md
server/migrate-*.ts
.review-tmp/
.review-tmp-ir.json
.env.local
.env*
.serena/
# Relying on a global ignore misses on other machines and on other clones.
.claude/settings.local.json

# Claude Code writes these beside a mod it loads (claude --plugin-dir pane): its own types and a tsconfig.json that extends them.
pane/.claude-plugin/types/
pane/tsconfig.json

# scripts/bundle.mjs builds these at publish time.
plugin/dist/
plugin/db/
# Its bun metafiles, for the bundle size check.
.build/

# scripts/bundle.mjs copies this from the root README.md.
plugin/README.md

# scripts/third-party-notices.mjs rebuilds this from node_modules.
plugin/THIRD_PARTY_NOTICES.md

# Left by npm pack. What gets published is rebuilt from bundle.
*.tgz

# Left by bun run mutation (StrykerJS): its sandboxes and its report.
.stryker-tmp/
reports/

# Left by claude plugin eval: each run's scores and report.
server/evals/plugin/cases/results/
