{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/pre-push.mjs", "scripts/lint-plugin.mjs"],
      "project": ["scripts/**/*.{js,mjs,cjs,ts}"],
      "ignoreDependencies": ["kysely", "kysely-codegen", "js-tokens", "oxlint", "oxfmt"],
      "ignoreBinaries": ["lefthook", "lychee"]
    },
    "server": {
      "entry": [
        "src/capture.ts",
        "src/deliver.ts",
        "src/git-worker.ts",
        "src/mcp-record.ts",
        "test/*.test.ts",
        "evals/cloud/build.ts",
        "evals/cloud/canary.ts",
        "evals/cloud/claude.ts",
        "evals/cloud/codex.ts",
        "evals/cloud/collect.ts",
        "evals/cloud/grade.ts",
        "evals/cloud/fixture.ts",
        "evals/cloud/fire.ts",
        "evals/cloud/report.ts",
        "evals/acceptance/shard-*.ts",
        "evals/asked/run.ts",
        "evals/delivery/sample.ts",
        "evals/order/run.ts",
        "evals/retrieval/run.ts",
        "evals/post-write/replay.ts",
        "evals/post-write/shell-miss.ts",
        "evals/post-write/transcript.ts",
        "evals/review/run.ts",
        "evals/scale/run.ts",
        "evals/trace/auto-trace.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts", "evals/**/*.ts"],
      "ignoreDependencies": [
        "@biomejs/biome",
        "js-tokens",
        "kysely-codegen",
        "lefthook",
        "markdownlint-cli2",
        "oxlint-tsgolint"
      ],
      "ignoreBinaries": ["codex", "mkfifo"]
    }
  },
  "ignoreIssues": {
    "server/src/db-types.ts": ["types"]
  }
}
