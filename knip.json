{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "project": ["scripts/**/*.{js,mjs,cjs,ts}"],
      "ignoreDependencies": ["kysely", "kysely-codegen", "js-tokens"],
      "ignoreBinaries": ["lefthook", "lychee"]
    },
    "server": {
      "entry": [
        "src/capture.ts",
        "src/deliver.ts",
        "src/mcp-record.ts",
        "test/*.test.ts",
        "evals/cloud/build.ts",
        "evals/cloud/canary.ts",
        "evals/cloud/claude.ts",
        "evals/cloud/codex.ts",
        "evals/cloud/collect.ts",
        "evals/cloud/grade.ts",
        "evals/cloud/fixture.ts",
        "evals/cloud/fire.ts",
        "evals/cloud/report.ts",
        "evals/asked/run.ts",
        "evals/order/run.ts",
        "evals/retrieval/run.ts",
        "evals/scale/run.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts", "evals/**/*.ts"],
      "ignoreDependencies": ["js-tokens", "kysely-codegen", "lefthook", "markdownlint-cli2"],
      "ignoreBinaries": ["codex"]
    }
  },
  "ignoreIssues": {
    "server/src/db-types.ts": ["types"]
  }
}
