{
  "name": "sphica",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "setup": "bun install --cwd server --frozen-lockfile",
    "cli": "node server/src/cli.ts",
    "lint": "server/node_modules/.bin/biome ci . --error-on-warnings",
    "fix": "server/node_modules/.bin/biome check --write .",
    "verify:ai": "node scripts/check-ai-config.mjs && node scripts/check-links.mjs",
    "architecture": "node scripts/check-architecture.mjs",
    "english": "node scripts/check-english.mjs",
    "markdown": "node scripts/check-markdown.mjs",
    "comments": "node scripts/check-comments.mjs",
    "headers": "node scripts/check-license-headers.mjs",
    "knip": "server/node_modules/.bin/knip",
    "typecheck": "bun run --cwd server typecheck",
    "check": "bun run lint && bun run verify:ai && bun run naming && bun run pairs && bun run rule-scopes && bun run sql && bun run architecture && bun run english && bun run markdown && bun run comments && bun run headers && bun run codegen:check && bun run typecheck && bun run knip",
    "test": "bun run --cwd server test",
    "verify": "bun run check && bun run bundle && bun run sql:reach && bun run sql:live && bun run hooks:live && bun run codex-trust:live && bun run acceptance",
    "bundle": "node scripts/bundle.mjs",
    "release:plan": "node scripts/release-plan.mjs",
    "release:status": "node scripts/release-status.mjs",
    "codegen": "node scripts/codegen.mjs",
    "codegen:check": "node scripts/codegen.mjs --check",
    "sql:reach": "node scripts/check-sql-reach.mjs",
    "sql:live": "node scripts/check-sql-live.mjs",
    "hooks:live": "node scripts/check-hooks-live.mjs",
    "codex-trust:live": "node scripts/check-codex-trust-live.mjs",
    "naming": "node scripts/check-naming.mjs",
    "notices": "node scripts/third-party-notices.mjs --check",
    "pairs": "node scripts/check-pairs.mjs",
    "rule-scopes": "node scripts/check-rule-scopes.mjs",
    "sql": "node scripts/check-sql.mjs",
    "acceptance": "bun run --cwd server acceptance"
  }
}
